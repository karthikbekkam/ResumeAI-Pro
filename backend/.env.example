# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production

# Database Configuration
# PostgreSQL format: postgresql://username:password@localhost:5432/resumeai_db
# SQLite fallback format for easy local dev testing: sqlite:///resumeai.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumeai_db

# Uploads Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max limit

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
